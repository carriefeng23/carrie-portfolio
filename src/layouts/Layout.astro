---
import "../styles/global.css";
const { title = "Carrie Feng" } = Astro.props;
---

---
const { title = "Carrie Feng" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
  </head>
  <body>
    <header class="container topbar">
      <a href="/" class="brand">
  
        <span>Carrie Feng</span>
      </a>


      <nav class="pill-nav">
        <a class={`pill-link ${Astro.url.pathname === "/" ? "active" : ""}`} href="/">Home</a>
        <a class={`pill-link ${Astro.url.pathname.startsWith("/projects") ? "active" : ""}`} href="/projects">Work</a>
        <a class={`pill-link ${Astro.url.pathname.startsWith("/about") ? "active" : ""}`} href="/about">About</a>
        <a class={`pill-link ${Astro.url.pathname.startsWith("/contact") ? "active" : ""}`} href="/contact">Contact</a>
      </nav>

      <div class="icon-row">
        <a class="icon-btn" href="https://github.com/carriefeng23" target = "_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
  <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
  0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
  1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
  0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
  1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15
  0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013
  8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
</svg>
</a>
        <a class="icon-btn" href="https://www.linkedin.com/in/carrie-feng23" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
        <a class="icon-btn" href="/resume.pdf" target="_blank" rel="noopener" aria-label="Resume">CV</a>
        <button class="icon-btn" id="themeToggle" aria-label="Toggle theme">
          ☾
        </button>

      </div>
    </header>

    <main class="container">
      <slot />
    </main>
    <script>
      const root = document.documentElement;
      const btn = document.getElementById("themeToggle");

      const saved = localStorage.getItem("theme");
      if (saved === "light") root.classList.remove("dark");
      if (saved === "dark") root.classList.add("dark");

      if (!saved) root.classList.add("dark");

      function syncIcon() {
        btn.textContent = root.classList.contains("dark") ? "☾" : "☀";
      }
      syncIcon();

      
      btn.addEventListener("click", () => {
        root.classList.toggle("dark");
        localStorage.setItem("theme", root.classList.contains("dark") ? "dark" : "light");
        syncIcon();
      });
    </script>

  </body>
</html>
