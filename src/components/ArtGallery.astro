      { src: "/art/others/sculpture1.jpeg",   title: "Tea Ceremony",               description: "mixed media: wood, steel, red clay, glaze, nails; Built everything from scratch, from cutting pieces of wood to building mini versions of tea tables, to welding metal rods to form a cup holder, and throwing stoneware mugs set. An attempt to recreate a childhood memory with my grandparents." },
      { src: "/art/others/sculpture1.1.jpeg", title: "Tea Ceremony — Aerial View", description: "" },
