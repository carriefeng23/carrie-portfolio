---

<section class="art-wrap">
  <div class="art-top">
    <div>
      <h2 class="art-h">Creative Corner</h2>
      <p class="art-p">Photography, ceramics, and ongoing experiments ;)</p>
    </div>

    <div class="art-filters" role="tablist" aria-label="Filter artworks">
      {filters.map((f) => (
        <button class="art-filter" data-filter={f.key} type="button">{f.label}</button>
      ))}
    </div>
  </div>

  <div class="art-grid" id="artGrid">
    {items.map((it) => (
      <button
        class="art-card"
        type="button"
        data-category={it.category}
        data-title={it.title}
        data-description={it.description}
        data-src={it.src}
      >
        <img class="art-thumb" src={it.src} alt={it.title} loading="lazy" />
        <div class="art-meta">
          <p class="art-title">{it.title}</p>
          <p class="art-sub">{it.category}</p>
        </div>
      </button>
    ))}
  </div>

  <!-- Modal -->
  <dialog class="art-modal" id="artModal">
    <form method="dialog" class="art-modal-inner">
      <button class="art-close" aria-label="Close">✕</button>
      <div class="art-modal-body">
        <img id="modalImg" class="art-modal-img" alt="" />
        <div class="art-modal-text">
          <h3 id="modalTitle" class="art-modal-title"></h3>
          <p id="modalDesc" class="art-modal-desc"></p>
        </div>
      </div>
    </form>
  </dialog>
</section>

<script>
  const grid = document.getElementById("artGrid");
  const buttons = document.querySelectorAll(".art-filter");

  // default filter: all
  let active = "all";
  buttons[0]?.classList.add("is-active");

  function applyFilter() {
    grid.querySelectorAll(".art-card").forEach((card) => {
      const cat = card.dataset.category;
      card.style.display = (active === "all" || cat === active) ? "" : "none";
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      active = btn.dataset.filter;
      applyFilter();
    });
  });

  // modal
  const modal = document.getElementById("artModal");
  const modalImg = document.getElementById("modalImg");
  const modalTitle = document.getElementById("modalTitle");
  const modalDesc = document.getElementById("modalDesc");

  grid.addEventListener("click", (e) => {
    const card = e.target.closest(".art-card");
    if (!card) return;

    modalImg.src = card.dataset.src;
    modalImg.alt = card.dataset.title;
    modalTitle.textContent = card.dataset.title;
    modalDesc.textContent = card.dataset.description;

    modal.showModal();
  });
</script>

<style>
  .art-wrap { margin-top: 48px; }
  .art-top { display:flex; justify-content:space-between; align-items:flex-end; gap:16px; flex-wrap:wrap; }
  .art-h { margin:0; font-size:32px; }
  .art-p { margin:10px 0 0; color: var(--muted); }

  .art-filters { display:flex; gap:10px; flex-wrap:wrap; }
  .art-filter {
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.06);
    color: var(--muted);
    cursor: pointer;
    font-weight: 600;
  }
  .art-filter.is-active {
    color: var(--text);
    background: linear-gradient(135deg, rgba(124,45,58,0.85), rgba(184,50,128,0.65));
    box-shadow: 0 12px 28px rgba(124,45,58,0.22);
  }

  .art-grid {
    margin-top: 18px;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .art-card {
    padding: 0;
    border: 0;
    text-align: left;
    cursor: zoom-in;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
  }

  .art-thumb { width: 100%; height: 340px; object-fit: cover; display:block; }


.art-meta {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    padding: 6px 10px;
    border-radius: 10px;
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(6px);
  }
  .art-title {
    margin: 0;
    font-weight: 600;
    font-size: 13px;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .art-sub {
    margin: 2px 0 0;
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* modal */
  .art-modal::backdrop { background: rgba(0,0,0,0.65); }
  .art-modal { border: none; padding: 0; border-radius: 18px; width: min(980px, 92vw); }
  .art-modal-inner { margin: 0; padding: 0; }
  .art-close {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.08);
    color: var(--text);
    cursor: pointer;
  }
  .art-modal-body { display:grid; grid-template-columns: 1fr 320px; gap: 16px; padding: 16px; background: rgba(10,8,14,0.95); }
  .art-modal-img { width:100%; height: 72vh; object-fit: contain; background: rgba(255,255,255,0.04); border-radius: 14px; }
  .art-modal-title { margin: 0 0 8px; font-size: 20px; }
  .art-modal-desc { margin: 0; color: var(--muted); line-height: 1.6; }

  @media (max-width: 860px){
    .art-modal-body { grid-template-columns: 1fr; }
    .art-modal-img { height: 56vh; }
  }
</style>
