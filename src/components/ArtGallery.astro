const filters = [
  { key: "all",         label: "All" },
  { key: "photography", label: "Photography" },
  { key: "ceramics",    label: "Ceramics" },
  { key: "others",      label: "Others" },
];
---

<section class="art-wrap">
  <div class="art-top">
    <div>
      <h2 class="art-h">Creative Corner</h2>
      <p class="art-p">Photography, ceramics, and ongoing experiments ;)</p>
    </div>
    <div class="art-filters" role="tablist" aria-label="Filter artworks">
      {filters.map((f) => (
        <button class="art-filter" data-filter={f.key} type="button">{f.label}</button>
      ))}
    </div>
  </div>

  <div class="art-grid" id="artGrid">
    {items.map((it) => (
      <button
        class="art-card"
        type="button"
        data-category={it.category}
        data-title={it.title}
        data-description={it.description}
        data-src={it.src}
        data-images={it.images ? JSON.stringify(it.images) : undefined}
      >
        <img class="art-thumb" src={it.src} alt={it.title} loading="lazy" />
        <div class="art-meta">
          <p class="art-title">{it.title}</p>
          <p class="art-sub">{it.category}</p>
        </div>
        {it.images && (
          <span class="art-count-badge">{it.images.length} photos</span>
        )}
      </button>
    ))}
  </div>

  <!-- Modal -->
  <dialog class="art-modal" id="artModal">
    <form method="dialog" class="art-modal-inner">
      <button class="art-close" aria-label="Close" type="submit">✕</button>
      <div class="art-modal-body">

        <div class="art-modal-left">
          <div class="art-img-wrap">
            <img id="modalImg" class="art-modal-img" alt="" />
            <button id="modalPrev" class="art-nav art-nav--prev" type="button" aria-label="Previous" hidden>&#8249;</button>
            <button id="modalNext" class="art-nav art-nav--next" type="button" aria-label="Next" hidden>&#8250;</button>
          </div>
        </div>

        <div class="art-modal-text">
          <h3 id="modalTitle" class="art-modal-title"></h3>
          <p id="modalDesc" class="art-modal-desc"></p>
        </div>

      </div>
    </form>
  </dialog>
</section>

<script>
  function initGallery() {
    const grid = document.getElementById("artGrid");
    if (!grid) return;

    const section = grid.closest(".art-wrap");
    const filterBtns = section?.querySelectorAll<HTMLElement>(".art-filter") ?? [];
    const modal      = document.getElementById("artModal")   as HTMLDialogElement | null;
    const modalImg   = document.getElementById("modalImg")   as HTMLImageElement  | null;
    const modalTitle = document.getElementById("modalTitle") as HTMLElement | null;
    const modalDesc  = document.getElementById("modalDesc")  as HTMLElement | null;
    const modalPrev  = document.getElementById("modalPrev")  as HTMLButtonElement | null;
    const modalNext  = document.getElementById("modalNext")  as HTMLButtonElement | null;
    if (!modal || !modalImg || !modalTitle || !modalDesc) return;

    // ── Filter logic ──────────────────────────────────────────────
    const paramFilter = new URLSearchParams(window.location.search).get("filter");
    let active = paramFilter ?? "all";

    filterBtns.forEach(b => b.classList.toggle("is-active", b.dataset.filter === active));
    if (!paramFilter) filterBtns[0]?.classList.add("is-active");

    function applyFilter() {
      grid.querySelectorAll<HTMLElement>(".art-card").forEach(card => {
        card.style.display = (active === "all" || card.dataset.category === active) ? "" : "none";
      });
    }
    applyFilter();

    filterBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        filterBtns.forEach(b => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        active = btn.dataset.filter ?? "all";
        applyFilter();
      });
    });

    // ── Multi-image modal ─────────────────────────────────────────
    type Slide = { src: string; title: string; description: string };
    let slides: Slide[] = [];
    let idx = 0;

    function goTo(i: number) {
      idx = i;
      const s = slides[i];
      modalImg!.src = s.src;
      modalImg!.alt = s.title;
      modalTitle!.textContent = s.title;
      modalDesc!.textContent  = s.description;
      if (modalPrev) modalPrev.hidden = (i === 0);
      if (modalNext) modalNext.hidden = (i === slides.length - 1);
    }

    grid.addEventListener("click", e => {
      const card = (e.target as Element).closest<HTMLElement>(".art-card");
      if (!card) return;

      const raw = card.dataset.images;
      if (raw) {
        slides = JSON.parse(raw) as Slide[];
      } else {
        slides = [{ src: card.dataset.src ?? "", title: card.dataset.title ?? "", description: card.dataset.description ?? "" }];
      }
      goTo(0);
      modal.showModal();
    });

    modalPrev?.addEventListener("click", () => { if (idx > 0) goTo(idx - 1); });
    modalNext?.addEventListener("click", () => { if (idx < slides.length - 1) goTo(idx + 1); });

    modal.addEventListener("click", e => { if (e.target === modal) modal.close(); });
  }

  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  .art-wrap { margin-top: 48px; }
  .art-top  { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .art-h    { margin: 0; font-size: 32px; }
  .art-p    { margin: 10px 0 0; color: var(--muted); }

  .art-filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .art-filter {
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.06);
    color: var(--muted);
    cursor: pointer;
    font-weight: 600;
  }
  .art-filter.is-active { color: #fff; background: var(--accent); }

  .art-grid {
    margin-top: 18px;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .art-card {
    padding: 0;
    border: 1px solid var(--border);
    text-align: left;
    cursor: zoom-in;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
  }

  .art-thumb { width: 100%; height: 340px; object-fit: cover; display: block; }

  .art-meta {
    position: absolute;
    left: 10px; right: 10px; bottom: 10px;
    padding: 6px 10px;
    border-radius: 10px;
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(6px);
  }
  .art-title {
    margin: 0; font-weight: 600; font-size: 13px; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .art-sub {
    margin: 2px 0 0; font-size: 11px; color: var(--muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* multi-photo badge */
  .art-count-badge {
    position: absolute;
    top: 10px; right: 10px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(4px);
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.88);
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  /* ── Modal ── */
  .art-modal::backdrop { background: rgba(0,0,0,0.65); }
  .art-modal {
    border: none; padding: 0;
    border-radius: 18px;
    width: min(1020px, 94vw);
    max-height: 92vh;
    overflow: hidden;
    background: var(--bg1);
    border: 1px solid var(--border);
  }
  .art-modal-inner { margin: 0; padding: 0; position: relative; }

  .art-close {
    position: absolute; right: 12px; top: 12px; z-index: 10;
    width: 40px; height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--text);
    cursor: pointer;
    font-size: 14px;
  }

  .art-modal-body {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 16px;
    padding: 16px;
  }

  .art-modal-left { min-width: 0; }

  .art-img-wrap { position: relative; }

  .art-modal-img {
    width: 100%; height: 64vh;
    object-fit: contain;
    background: var(--bg0);
    border-radius: 14px;
    display: block;
  }

  /* nav arrows — always dark/light over image, independent of theme */
  .art-nav {
    position: absolute;
    top: 50%; transform: translateY(-50%);
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--text);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.18s;
    z-index: 2;
  }
  .art-nav:hover { background: var(--bg1); }
  .art-nav--prev { left: 10px; }
  .art-nav--next { right: 10px; }
  .art-nav[hidden] { display: none; }

  /* right column: text */
  .art-modal-text { padding-top: 4px; }
  .art-modal-title { margin: 0 0 8px; font-size: 20px; color: var(--text); }
  .art-modal-desc  { margin: 0; color: var(--muted); line-height: 1.6; font-size: 14px; }

  @media (max-width: 720px) {
    .art-modal-body { grid-template-columns: 1fr; }
    .art-modal-img  { height: 52vh; }
  }
</style>
