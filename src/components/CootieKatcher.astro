<div class="sys-wrap">
  <canvas id="sys-canvas" aria-label="Orbiting traits — hover a planet to explore, click to read"></canvas>
  <p class="sys-label" id="sysLabel" data-state="hint">hover a planet</p>
  <p class="sys-quote" id="sysQuote"></p>
</div>

<script>
  const PLANETS = [
    { label: 'CURIOUS',    quote: "I came to GIS, ceramics, and running the same way — I wanted to understand something I couldn't yet.",                              r: 44,  speed: 0.009,  angle: 0.5,  size: 6   },
    { label: 'SKEPTICAL',  quote: "Luxury brands in my dataset scored lower on supply chain transparency than H&M. That was not what I expected.",                    r: 66,  speed: 0.006,  angle: 2.1,  size: 4   },
    { label: 'EMPATHETIC', quote: "Seeing transit deserts on a map is different from reading them in a table. A good visualization changes what you think to ask.",   r: 85,  speed: 0.004,  angle: 3.8,  size: 6   },
    { label: 'CREATIVE',   quote: "I shoot film when I want to slow down. I throw clay when I want to stop thinking. I make maps when both fail.",                    r: 104, speed: 0.003,  angle: 1.0,  size: 4   },
    { label: 'RESILIENT',  quote: "The pottery wheel doesn't care how smart you are. It just keeps spinning until you figure it out.",                                r: 122, speed: 0.002,  angle: 4.5,  size: 5.5 },
    { label: 'OBSERVANT',  quote: "I notice when the numbers don't match the narrative. That's true of data and of people.",                                           r: 138, speed: 0.0014, angle: 2.8,  size: 4   },
    { label: 'GROUNDED',   quote: "Ceramics, running, film — I keep coming back to things that are slow and physical. They remind me what real work feels like.",      r: 153, speed: 0.001,  angle: 1.5,  size: 5   },
  ];

  let rafId: number | null = null;

  document.addEventListener('astro:before-preparation', () => {
    if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
  });

  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('sys-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d')!;
    const SIZE = 340;
    const dpr  = window.devicePixelRatio || 1;
    canvas.width  = SIZE * dpr;
    canvas.height = SIZE * dpr;
    canvas.style.width  = SIZE + 'px';
    canvas.style.height = SIZE + 'px';
    ctx.scale(dpr, dpr);

    const cx = SIZE / 2, cy = SIZE / 2;

    // Mutable per-frame state for each planet
    const planets = PLANETS.map(p => ({ ...p, curSpeed: p.speed }));

    let hoveredIdx   = -1;
    let clickedIdx   = -1;
    let lastHovIdx   = -2; // sentinel so first frame always syncs DOM
    let mouseX = -999, mouseY = -999;

    const labelEl = document.getElementById('sysLabel') as HTMLElement | null;
    const quoteEl = document.getElementById('sysQuote') as HTMLElement | null;

    const getAccent = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#b83050';
    const isDark = () => !document.documentElement.classList.contains('light');
    const lerp   = (a: number, b: number, t: number) => a + (b - a) * t;

    function planetPos(p: typeof planets[0]) {
      return { x: cx + Math.cos(p.angle) * p.r, y: cy + Math.sin(p.angle) * p.r };
    }

    function hitTest(p: typeof planets[0]) {
      const pos  = planetPos(p);
      const rect = canvas.getBoundingClientRect();
      const dx   = mouseX - rect.left - pos.x;
      const dy   = mouseY - rect.top  - pos.y;
      return Math.hypot(dx, dy) < Math.max(p.size + 8, 14);
    }

    function draw() {
      const accent = getAccent();
      const dark   = isDark();
      const orbitC = dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
      const dotC   = dark ? 'rgba(240,237,232,0.42)' : 'rgba(15,10,10,0.36)';

      ctx.clearRect(0, 0, SIZE, SIZE);

      // Orbital paths (dashed)
      ctx.setLineDash([3, 5]);
      ctx.lineWidth = 1;
      planets.forEach(p => {
        ctx.beginPath();
        ctx.arc(cx, cy, p.r, 0, Math.PI * 2);
        ctx.strokeStyle = orbitC;
        ctx.stroke();
      });
      ctx.setLineDash([]);

      // Planet dots
      planets.forEach((p, i) => {
        const pos    = planetPos(p);
        const isHov  = i === hoveredIdx;
        const isSel  = i === clickedIdx;

        // Halo for hovered / selected
        if (isHov || isSel) {
          ctx.beginPath();
          ctx.arc(pos.x, pos.y, p.size + 6, 0, Math.PI * 2);
          ctx.fillStyle = accent + '28';
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(pos.x, pos.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = (isHov || isSel) ? accent : dotC;
        ctx.fill();
      });

      // Center sun — outer glow
      ctx.beginPath();
      ctx.arc(cx, cy, 20, 0, Math.PI * 2);
      ctx.fillStyle = accent + '22';
      ctx.fill();
      // Sun core
      ctx.beginPath();
      ctx.arc(cx, cy, 12, 0, Math.PI * 2);
      ctx.fillStyle = accent;
      ctx.fill();
      // CF monogram
      ctx.textAlign    = 'center';
      ctx.textBaseline = 'middle';
      ctx.font         = 'bold 6px "Inter", system-ui, sans-serif';
      ctx.fillStyle    = '#fff';
      ctx.fillText('CF', cx, cy);
    }

    function syncLabel() {
      if (hoveredIdx === lastHovIdx) return;
      lastHovIdx = hoveredIdx;
      if (!labelEl) return;

      if (hoveredIdx >= 0) {
        labelEl.textContent  = '⬤  ' + planets[hoveredIdx].label;
        labelEl.dataset.state = 'name';
      } else {
        labelEl.textContent  = 'hover a planet';
        labelEl.dataset.state = 'hint';
      }
    }

    function frame() {
      // Hit test
      hoveredIdx = -1;
      planets.forEach((p, i) => { if (hitTest(p)) hoveredIdx = i; });

      // Update speeds + angles
      planets.forEach((p, i) => {
        p.curSpeed = lerp(p.curSpeed, i === hoveredIdx ? 0 : p.speed, 0.08);
        p.angle   += p.curSpeed;
      });

      canvas.style.cursor = hoveredIdx >= 0 ? 'pointer' : 'default';
      syncLabel();
      draw();
      rafId = requestAnimationFrame(frame);
    }

    // ── Events ──
    canvas.addEventListener('mousemove', (e) => { mouseX = e.clientX; mouseY = e.clientY; });
    canvas.addEventListener('mouseleave', () => { mouseX = -999; mouseY = -999; });

    canvas.addEventListener('click', () => {
      if (hoveredIdx < 0) return;
      if (clickedIdx === hoveredIdx) {
        clickedIdx = -1;
        quoteEl?.classList.remove('is-visible');
      } else {
        clickedIdx = hoveredIdx;
        if (quoteEl) {
          quoteEl.textContent = planets[clickedIdx].quote;
          quoteEl.classList.add('is-visible');
        }
      }
    });

    // Touch tap — find nearest planet and reveal quote
    canvas.addEventListener('touchend', (e) => {
      e.preventDefault();
      const touch = e.changedTouches[0];
      const rect  = canvas.getBoundingClientRect();
      const tx    = touch.clientX - rect.left;
      const ty    = touch.clientY - rect.top;

      let nearest = -1, nearestDist = 24;
      planets.forEach((p, i) => {
        const pos  = planetPos(p);
        const dist = Math.hypot(tx - pos.x, ty - pos.y);
        if (dist < nearestDist) { nearestDist = dist; nearest = i; }
      });

      if (nearest >= 0) {
        clickedIdx = nearest === clickedIdx ? -1 : nearest;
        if (quoteEl) {
          if (clickedIdx >= 0) {
            quoteEl.textContent = planets[clickedIdx].quote;
            quoteEl.classList.add('is-visible');
          } else {
            quoteEl.classList.remove('is-visible');
          }
        }
        if (labelEl && clickedIdx >= 0) {
          labelEl.textContent   = '⬤  ' + planets[clickedIdx].label;
          labelEl.dataset.state = 'name';
        }
      }
    }, { passive: false });

    rafId = requestAnimationFrame(frame);
  });
</script>

<style>
  .sys-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    user-select: none;
  }

  #sys-canvas { display: block; }

  .sys-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0;
    min-height: 1.2em;
    text-align: center;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .sys-label[data-state="hint"] { opacity: 0.35; color: var(--text); }
  .sys-label[data-state="name"] { opacity: 1;    color: var(--accent); }

  .sys-quote {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1.72;
    text-align: center;
    max-width: 260px;
    min-height: 2.8em;
    margin: 0;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .sys-quote.is-visible {
    opacity: 0.86;
    transform: translateY(0);
  }
</style>
