---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={project.data.title}>
  <section style="padding: 64px 0; max-width: 900px; margin: 0 auto;">
    <h1 style="font-size: 44px; margin: 0 0 12px;">{project.data.title}</h1>

    {project.data.description && (
      <p style="opacity: 0.75; margin: 0 0 24px;">
        {project.data.description}
      </p>
    )}

    {project.data.cover && (
      <img
        src={project.data.cover}
        alt={project.data.title}
        style="width:100%; max-width:900px; border-radius:24px; margin:24px 0;"
        loading="lazy"
      />
    )}

    <article class="project-content">
      <Content />
    </article>
  </section>
</Layout>
