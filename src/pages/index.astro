---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CootieKatcher from "../components/CootieKatcher.astro";

const allProjects = await getCollection("projects");
// Hand-pick the two strongest case studies for the homepage preview
const featuredSlugs = ["meal-lottery", "obesity-decisiontree"];
const featured = featuredSlugs
  .map((s) => allProjects.find((p) => p.slug === s))
  .filter(Boolean);
---

<Layout title="Carrie Feng">
  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker"> NYC · Information Science · Environmental Analysis</p>

      <h1 class="h1">
        Carrie<br />Feng
      </h1>

      <p class="hero-tagline">I tell stories through models, dashboards, and maps.</p>

      <div class="hero-bottom">
         
        </p>
        <div class="hero-side">
          <div class="pills">
            <span class="pill">Data Analytics</span>
            <span class="pill">Climate & Sustainability</span>
            
          </div>
          <div class="hero-actions">
            <a href="/projects" class="btn-primary">View my work</a>
            <a href="/studio" class="btn-ghost">Studio →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-cootie">
      <CootieKatcher />
    </div>
  </section>

  <!-- ── Marquee ────────────────────────────────────────────── -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-text">DATA ANALYTICS &nbsp;·&nbsp; BRAND TRANSPARENCY &nbsp;·&nbsp; CERAMICS &nbsp;·&nbsp; SUSTAINABILITY &nbsp;·&nbsp; PHOTOGRAPHY &nbsp;·&nbsp; MACHINE LEARNING &nbsp;·&nbsp; ENVIRONMENTAL ANALYSIS &nbsp;·&nbsp; R &nbsp;·&nbsp; PYTHON &nbsp;·&nbsp; GIS &nbsp;·&nbsp; BARNARD COLLEGE &nbsp;·&nbsp; DATA VIZ &nbsp;·&nbsp; ESG &nbsp;·&nbsp;</span>
      <span class="marquee-text">DATA ANALYTICS &nbsp;·&nbsp; BRAND TRANSPARENCY &nbsp;·&nbsp; CERAMICS &nbsp;·&nbsp; SUSTAINABILITY &nbsp;·&nbsp; PHOTOGRAPHY &nbsp;·&nbsp; MACHINE LEARNING &nbsp;·&nbsp; ENVIRONMENTAL ANALYSIS &nbsp;·&nbsp; R &nbsp;·&nbsp; PYTHON &nbsp;·&nbsp; GIS &nbsp;·&nbsp; BARNARD COLLEGE &nbsp;·&nbsp; DATA VIZ &nbsp;·&nbsp; ESG &nbsp;·&nbsp;</span>
    </div>
  </div>

  <!-- ── Selected Work ─────────────────────────────────────── -->
  <section id="work">
    <div class="section-header reveal">
      <h2 class="section-title">Selected Work</h2>
      <a href="/projects" class="view-all">View all projects →</a>
    </div>

    <div class="featured-list">
      {/* Meal Lottery */}
      {featured[0] && (
        <a class="featured-row reveal" href={`/projects/${featured[0].slug}`} style="transition-delay: 0s">
          <div class="featured-img-wrap">
            {featured[0].data.cover
              ? <img src={featured[0].data.cover} alt={featured[0].data.title} loading="lazy" />
              : <span class="featured-img-placeholder">{featured[0].data.title}</span>
            }
          </div>
          <div class="featured-info">
            <p class="featured-tags">
              {[...featured[0].data.tags.slice(0, 3), String(featured[0].data.publishDate.getFullYear())].join(" · ")}
            </p>
            <h3 class="featured-title">{featured[0].data.title}</h3>
            <p class="featured-desc">{featured[0].data.description}</p>
            {featured[0].data.outcome && <p class="featured-outcome">{featured[0].data.outcome}</p>}
            <span class="featured-cta">View case study →</span>
          </div>
        </a>
      )}

      {/* GIS — standalone page */}
      <a class="featured-row reveal" href="/gis" style="transition-delay: 0.1s">
        <div class="featured-img-wrap">
          <img src="/images/gis-cover.png" alt="GIS & Spatial Analysis" loading="lazy" />
        </div>
        <div class="featured-info">
          <p class="featured-tags">QGIS · Spatial Analysis · Census Data · 2025–2026</p>
          <h3 class="featured-title">GIS & Spatial Analysis</h3>
          <p class="featured-desc">Maps built with QGIS and open datasets: poverty distribution, park access, subway equity, hurricane damage, and more.</p>
          <span class="featured-cta">View all maps →</span>
        </div>
      </a>

      {/* Beyond BMI */}
      {featured[1] && (
        <a class="featured-row reveal" href={`/projects/${featured[1].slug}`} style="transition-delay: 0.2s">
          <div class="featured-img-wrap">
            {featured[1].data.cover
              ? <img src={featured[1].data.cover} alt={featured[1].data.title} loading="lazy" />
              : <span class="featured-img-placeholder">{featured[1].data.title}</span>
            }
          </div>
          <div class="featured-info">
            <p class="featured-tags">
              {[...featured[1].data.tags.slice(0, 3), String(featured[1].data.publishDate.getFullYear())].join(" · ")}
            </p>
            <h3 class="featured-title">{featured[1].data.title}</h3>
            <p class="featured-desc">{featured[1].data.description}</p>
            {featured[1].data.outcome && <p class="featured-outcome">{featured[1].data.outcome}</p>}
            <span class="featured-cta">View case study →</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <!-- ── Creative Corner teaser ───────────────────────────── -->
  <section class="creative-teaser reveal">
    <div class="section-header">
      <div>
        <p class="kicker" style="margin-bottom: 6px;">Beyond data</p>
        <h2 class="section-title">Creative Corner</h2>
      </div>
      <a href="/studio" class="view-all">Explore all →</a>
    </div>

    <div class="creative-grid">
      <a href="/studio?filter=ceramics#gallery" class="creative-cell creative-cell--tall">
        <img src="/art/ceramics/ceramics8.jpeg" alt="When the Worlds Collide" loading="lazy" />
        <span class="creative-label">Ceramics</span>
      </a>
      <a href="/studio?filter=photography#gallery" class="creative-cell">
        <img src="/art/photo/photo2.jpeg" alt="D.C. Spring Afternoon" loading="lazy" />
        <span class="creative-label">Photography</span>
      </a>
      <a href="/studio?filter=ceramics#gallery" class="creative-cell">
        <img src="/art/ceramics/ceramics14.png" alt="Body Toxins" loading="lazy" />
        <span class="creative-label">Ceramics</span>
      </a>
      <a href="/studio?filter=others#gallery" class="creative-cell">
        <img src="/art/others/sculpture1.jpeg" alt="Tea Ceremony" loading="lazy" />
        <span class="creative-label">Sculpture</span>
      </a>
    </div>
  </section>

  <!-- ── Who I Am ──────────────────────────────────────────── -->
  <section class="home-bio reveal">
    <div class="home-bio-header">
      <h2 class="section-title">Who I am</h2>
    </div>
    <div class="home-bio-grid">
      <div class="home-bio-portrait-wrap">
        <img class="home-bio-portrait" src="/portrait.jpg" alt="Carrie Feng" />
      </div>
      <div class="home-bio-text">
        <p>
          I'm studying Information Science and Environmental Analysis at Barnard College in New York City.
          Growing up in Hong Kong, where dense urban life and nature are always intertwined, shaped my
          interest in environmental data and justice, GIS has since added a spatial dimension to those
          questions. I mostly work in Python, R, Tableau, Figma, and ArcGIS.
        </p>
        <p>
          Outside of class, I'm usually behind a camera, running at Riverside Park, at a pottery wheel, or somewhere I haven't been
          before. I'm a hands-on person who finds a lot of inspiration in everyday life, whether it's wandering through
          galleries and exhibitions, trying new restaurants, or just being out in the city. Feel free to ask me for NYC recommendations!
        </p>
      </div>
    </div>
  </section>

  <!-- ── Contact CTA ───────────────────────────────────────── -->
  <section id="contact">
    <div class="contact-cta reveal">
      <p class="kicker">Let's connect</p>
      <h2 class="cta-heading">Open to opportunities</h2>
      <p class="cta-sub">
        I'm looking for roles in data analytics, sustainability, and
        environmental research. If you're working on something that could use
        a data-driven perspective, I'd love to hear about it — or if you just want to
        chat and need a good NYC restaurant recommendation, I'm here for that too!!
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary">Get in touch</a>
        <a
          href="https://www.linkedin.com/in/carrie-feng23"
          target="_blank"
          rel="noopener"
          class="btn-ghost"
        >LinkedIn →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .featured-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.2;
    text-align: center;
    padding: 16px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.03) 0px,
      rgba(255,255,255,0.03) 10px,
      transparent 10px,
      transparent 20px
    );
  }
  .pills { flex-wrap: nowrap; }
  .pill { white-space: nowrap; }
  .hero-bottom { border-top: none; padding-top: 0; }

  .creative-teaser { padding: 80px 0; }

  .creative-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: 260px 260px;
    gap: 10px;
  }

  .creative-cell--tall { grid-row: span 2; }

  .creative-cell {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--border);
    display: block;
    text-decoration: none;
  }

  .creative-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .creative-cell:hover img { transform: scale(1.05); }

  .creative-label {
    position: absolute;
    bottom: 10px;
    left: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(0, 0, 0, 0.48);
    padding: 4px 8px;
    border-radius: 3px;
    backdrop-filter: blur(4px);
  }

  @media (max-width: 640px) {
    .creative-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px;
    }
    .creative-cell--tall { grid-row: span 1; }
  }
</style>
