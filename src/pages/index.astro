---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Carrie Feng">
  <section class="hero">
    <div>
      <p class="kicker">Information Science · Environmental Analysis</p>

      <h1 class="h1">
        Hello, my name is<br />
        Carrie Feng
      </h1>

      <p class="lede">
        I’m exploring how data, climate systems, and consumer narratives intersect — from climate
        risk to how fashion brands communicate sustainability. I use data + research to turn complex
        topics into clear, actionable insights.
      </p>

      <div class="pills">
        <span class="pill">Data Analyst</span>
        <span class="pill">Climate / Sustainability</span>
        <span class="pill">Product Storytelling</span>
      </div>
    </div>

    <div class="portrait-wrap">
      <div class="portrait-glow"></div>
      <div class="portrait">
        <!-- Put your photo in /public as "portrait.jpg" -->
        <img src="/portrait.jpg" alt="Portrait of Carrie Feng" />
      </div>
    </div>
  </section>
</Layout>
