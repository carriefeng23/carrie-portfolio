---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Carrie Feng">
  <section class="hero">
    <div>
      <p class="kicker">Information Science · Environmental Analysis</p>

      <h1 class="h1">
        Hey there! I'm <br />
        Carrie Feng
      </h1>

      <p class="lede">
        I'm a 3rd year student studying Information and Environmental Analysis. I aspire to become a data analyst and storyteller. I take complex data and systems and turn them into interesting narratives that people can actually use. I'm driven by a curiosity about how data can influence behavior and how good storytelling drives impact!
      </p>

      <div class="pills">
        <span class="pill">Data Analyst</span>
        <span class="pill">Climate / Sustainability</span>
        <span class="pill">Product Storytelling</span>
      </div>
    </div>

    <div class="portrait-wrap">
      <div class="portrait-glow"></div>
      <div class="portrait">
        <!-- Put your photo in /public as "portrait.jpg" -->
        <img src="/portrait.jpg" alt="Portrait of Carrie Feng" />
      </div>
    </div>
  </section>
</Layout>
