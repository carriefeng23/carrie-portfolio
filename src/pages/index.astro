---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CootieKatcher from "../components/CootieKatcher.astro";

const allProjects = await getCollection("projects");
// Hand-pick the two strongest case studies for the homepage preview
const featuredSlugs = ["fashion", "obesity-decisiontree"];
const featured = featuredSlugs
  .map((s) => allProjects.find((p) => p.slug === s))
  .filter(Boolean);
---

<Layout title="Carrie Feng">
  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Barnard College · Information Science · Environmental Analysis</p>

      <h1 class="h1">
        Carrie<br />Feng
      </h1>

      <p class="hero-tagline">I find the gap between what data says and what we choose to believe.</p>

      <div class="hero-bottom">
        <p class="lede">
          Dashboards, models, and visualizations where data meets honesty.
          I work across sustainability, public health, and consumer transparency —
          drawn to the moment a number contradicts a comfortable narrative.
        </p>
        <div class="hero-side">
          <div class="pills">
            <span class="pill">Data Analytics</span>
            <span class="pill">Climate & Sustainability</span>
            <span class="pill">Brand Transparency</span>
          </div>
          <div class="hero-actions">
            <a href="/projects" class="btn-primary">View my work</a>
            <a href="/studio" class="btn-ghost">Studio →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-cootie">
      <CootieKatcher />
    </div>
  </section>

  <!-- ── Marquee ────────────────────────────────────────────── -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-text">DATA ANALYTICS &nbsp;·&nbsp; BRAND TRANSPARENCY &nbsp;·&nbsp; CERAMICS &nbsp;·&nbsp; SUSTAINABILITY &nbsp;·&nbsp; PHOTOGRAPHY &nbsp;·&nbsp; MACHINE LEARNING &nbsp;·&nbsp; ENVIRONMENTAL ANALYSIS &nbsp;·&nbsp; R &nbsp;·&nbsp; PYTHON &nbsp;·&nbsp; GIS &nbsp;·&nbsp; BARNARD COLLEGE &nbsp;·&nbsp; DECISION TREES &nbsp;·&nbsp; DATA VIZ &nbsp;·&nbsp; ESG &nbsp;·&nbsp;</span>
      <span class="marquee-text">DATA ANALYTICS &nbsp;·&nbsp; BRAND TRANSPARENCY &nbsp;·&nbsp; CERAMICS &nbsp;·&nbsp; SUSTAINABILITY &nbsp;·&nbsp; PHOTOGRAPHY &nbsp;·&nbsp; MACHINE LEARNING &nbsp;·&nbsp; ENVIRONMENTAL ANALYSIS &nbsp;·&nbsp; R &nbsp;·&nbsp; PYTHON &nbsp;·&nbsp; GIS &nbsp;·&nbsp; BARNARD COLLEGE &nbsp;·&nbsp; DECISION TREES &nbsp;·&nbsp; DATA VIZ &nbsp;·&nbsp; ESG &nbsp;·&nbsp;</span>
    </div>
  </div>

  <!-- ── Selected Work ─────────────────────────────────────── -->
  <section id="work">
    <div class="section-header reveal">
      <h2 class="section-title">Selected Work</h2>
      <a href="/projects" class="view-all">View all projects →</a>
    </div>

    <div class="featured-list">
      {featured.map((p, i) => (
        <a
          class="featured-row reveal"
          href={`/projects/${p!.slug}`}
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="featured-img-wrap">
            <img src={p!.data.cover} alt={p!.data.title} loading="lazy" />
          </div>
          <div class="featured-info">
            <p class="featured-tags">
              {[...p!.data.tags.slice(0, 3), String(p!.data.publishDate.getFullYear())].join(" · ")}
            </p>
            <h3 class="featured-title">{p!.data.title}</h3>
            <p class="featured-desc">{p!.data.description}</p>
            {p!.data.outcome && <p class="featured-outcome">{p!.data.outcome}</p>}
            <span class="featured-cta">View case study →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Manifesto ─────────────────────────────────────────── -->
  <blockquote class="manifesto reveal">
    The interesting part is when the data contradicts what we wanted to believe.
  </blockquote>

  <!-- ── Creative Corner teaser ───────────────────────────── -->
  <section class="creative-teaser reveal">
    <div class="section-header">
      <div>
        <p class="kicker" style="margin-bottom: 6px;">Beyond the data</p>
        <h2 class="section-title">Creative Corner</h2>
      </div>
      <a href="/studio" class="view-all">Explore all →</a>
    </div>

    <div class="creative-grid">
      <a href="/studio" class="creative-cell creative-cell--tall">
        <img src="/art/ceramics/ceramics8.jpeg" alt="When the Worlds Collide" loading="lazy" />
        <span class="creative-label">Ceramics</span>
      </a>
      <a href="/studio" class="creative-cell">
        <img src="/art/photo/photo2.jpeg" alt="D.C. Spring Afternoon" loading="lazy" />
        <span class="creative-label">Photography</span>
      </a>
      <a href="/studio" class="creative-cell">
        <img src="/art/ceramics/ceramics14.png" alt="Body Toxins" loading="lazy" />
        <span class="creative-label">Ceramics</span>
      </a>
      <a href="/studio" class="creative-cell">
        <img src="/art/others/sculpture1.jpeg" alt="Tea Ceremony" loading="lazy" />
        <span class="creative-label">Sculpture</span>
      </a>
    </div>
  </section>

  <!-- ── Who I Am ──────────────────────────────────────────── -->
  <section class="home-bio reveal">
    <div class="home-bio-header">
      <p class="kicker">The person</p>
      <h2 class="section-title">Who I am</h2>
    </div>
    <div class="home-bio-grid">
      <div class="home-bio-portrait-wrap">
        <img class="home-bio-portrait" src="/portrait.jpg" alt="Carrie Feng" />
      </div>
      <div class="home-bio-text">
        <p>
          My work lives at the intersection of data and communication. I'm
          interested in the moment a complex dataset stops feeling overwhelming
          and starts becoming useful — and I build toward that deliberately,
          through visualization, analysis, and design.
        </p>
        <p>
          I'm especially drawn to questions of brand transparency and consumer
          trust: the gap between what organizations claim and what their data
          actually shows. My fashion project started there — I wanted to know
          whether a luxury price tag actually buys better ethics. It mostly
          doesn't, and I think that's worth saying clearly.
        </p>
        <p>
          Outside of class, I'm usually behind a camera, at a pottery wheel, or
          somewhere I haven't been before. I recently picked up running, which I
          suspect is mostly an excuse to think quietly. I like having a mix of
          things I'm good at and things I'm still figuring out — it keeps me
          honest.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Contact CTA ───────────────────────────────────────── -->
  <section id="contact">
    <div class="contact-cta reveal">
      <p class="kicker">Let's connect</p>
      <h2 class="cta-heading">Have a project in mind?</h2>
      <p class="cta-sub">
        I'm open to internships and collaborations in data analytics,
        sustainability, and product storytelling.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary">Get in touch</a>
        <a
          href="https://www.linkedin.com/in/carrie-feng23"
          target="_blank"
          rel="noopener"
          class="btn-ghost"
        >LinkedIn →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .creative-teaser { padding: 80px 0; }

  .creative-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: 260px 260px;
    gap: 10px;
  }

  .creative-cell--tall { grid-row: span 2; }

  .creative-cell {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--border);
    display: block;
    text-decoration: none;
  }

  .creative-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .creative-cell:hover img { transform: scale(1.05); }

  .creative-label {
    position: absolute;
    bottom: 10px;
    left: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(0, 0, 0, 0.48);
    padding: 4px 8px;
    border-radius: 3px;
    backdrop-filter: blur(4px);
  }

  @media (max-width: 640px) {
    .creative-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px;
    }
    .creative-cell--tall { grid-row: span 1; }
  }
</style>
