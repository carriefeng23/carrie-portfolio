---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<Layout title="Work">
  <section style="padding: 64px 0;">
    <h1 style="font-size: 52px;">My Work</h1>
    <p style="opacity: 0.75; max-width: 60ch;">
      Click a project to open the full case study.
    </p>

    <div class="projects-grid">
      {projects.map((p) => (
        <a class="project-card" href={`/projects/${p.slug}`}>
          <img
            src={p.data.cover}
            alt={p.data.title}
            style="width:100%; border-radius:18px; margin-bottom:12px;"
          />
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
