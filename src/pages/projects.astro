---
import Layout from "../layouts/Layout.astro";

const projects = [
  { title: "Mapping climate risk indicators", tags: "Climate · Data Viz", status: "In progress" },
  { title: "What job postings reveal about analyst roles", tags: "Data · Career", status: "In progress" },
  { title: "How fashion brands communicate sustainability", tags: "Fashion · Product Marketing", status: "In progress" },
];
---
<Layout title="Projects | Carrie Feng">
  <h1 class="h1" style="font-size:34px;">Projects</h1>
  <p class="subhead">
    Short case studies in a simple format: context → question → method → insights → so what.
  </p>

  <div class="grid">
    {projects.map((p) => (
      <div class="card">
        <div class="row">
          <div>
            <p class="card-title">{p.title}</p>
            <p class="card-meta">{p.tags}</p>
          </div>
          <span class="badge">{p.status}</span>
        </div>
      </div>
    ))}
  </div>
</Layout>
