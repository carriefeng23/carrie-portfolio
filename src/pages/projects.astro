---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sorted = [...projects].sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<Layout title="Work | Carrie Feng">
  <section style="padding: 72px 0 0;">
    <div class="reveal">
      <p class="kicker">Portfolio</p>
      <h1 class="work-heading">My Work</h1>
      <p class="work-sub">
        These started as questions I couldn't get a straight answer to.
        Click through for the full write-up.
      </p>
    </div>

    <div class="project-list">
      {sorted.map((p, i) => (
        <a
          class="project-row reveal"
          href={`/projects/${p.slug}`}
          style={`transition-delay: ${i * 0.08}s`}
        >
          <div class="project-row-img">
            <img src={p.data.cover} alt={p.data.title} loading="lazy" />
          </div>
          <div class="project-row-info">
            <p class="project-row-tags">
              {[...p.data.tags.slice(0, 3), String(p.data.publishDate.getFullYear())].join(" · ")}
            </p>
            <h2 class="project-row-title">{p.data.title}</h2>
            <p class="project-row-desc">{p.data.description}</p>
            {p.data.outcome && (
              <p class="project-row-outcome">{p.data.outcome}</p>
            )}
            <span class="project-row-cta">View case study →</span>
          </div>
        </a>
      ))}

      <!-- GIS collection — standalone page -->
      <a class="project-row reveal" href="/gis" style={`transition-delay: ${sorted.length * 0.08}s`}>
        <div class="project-row-img project-row-img--gis">
          <span class="gis-map-label">GIS</span>
        </div>
        <div class="project-row-info">
          <p class="project-row-tags">QGIS · Spatial Analysis · Census Data · 2024–2025</p>
          <h2 class="project-row-title">GIS & Spatial Analysis</h2>
          <p class="project-row-desc">
            Maps built with QGIS and open datasets: poverty distribution,
            park access, subway equity, hurricane damage, and more.
          </p>
          <span class="project-row-cta">View all maps →</span>
        </div>
      </a>
    </div>
  </section>
</Layout>

<style>
  .work-heading {
    font-family: "Playfair Display", serif;
    font-size: clamp(40px, 8vw, 68px);
    letter-spacing: -0.03em;
    margin: 10px 0 14px;
    line-height: 1.05;
  }
  .work-sub {
    opacity: 0.6;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.72;
    margin: 0 0 16px;
  }

  /* GIS card placeholder image */
  .project-row-img--gis {
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.04) 0px,
      rgba(255,255,255,0.04) 10px,
      transparent 10px,
      transparent 20px
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gis-map-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.35;
    border: 1px solid currentColor;
    padding: 6px 16px;
    border-radius: 999px;
  }
</style>
